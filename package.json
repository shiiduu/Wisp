{
  "name": "wisp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "dev:landing": "pnpm --filter @wisp/landing dev",
    "dev:mockup": "pnpm --filter @wisp/mockup dev",
    "dev:select": "pnpm --filter @wisp/select dev",
    "build": "pnpm --filter @wisp/landing build && pnpm --filter @wisp/select build && pnpm --filter @wisp/mockup build && node scripts/assemble-site.mjs",
    "lint": "eslint .",
    "test": "pnpm --filter @wisp/engine test",
    "format": "prettier --write .",
    "fetch:augments": "pnpm --filter @wisp/data fetch:augments",
    "fetch:items": "pnpm --filter @wisp/data fetch:items",
    "fetch:champions": "pnpm --filter @wisp/data fetch:champions"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0+sha512.4abf725084d7bcbafbd728bfc7bee61f2f791f977fd87542b3579dcb23504d170d46337945e4c66485cd12d588a0c0e570ed9c477e7ccdd8507cf05f3f92eaca"
}
